# Keep Git focused on the course folders.  Ignore all other root-level files
# and directories, including macOS and local automation artifacts.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/EE-*/
!/ntu-eee-course-reviews-rednote.md

# Track project slash-commands but nothing else under .claude/
!/.claude/
/.claude/*
!/.claude/commands/
