# Keep Git focused on the course folders.  Ignore all other root-level files
# and directories, including macOS and local automation artifacts.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/docs/
!/EE-*/
!/ntu-eee-course-reviews-rednote.md

# NTU Library past-year exam papers: NTU-only access, copyright notice.
# Keep local; never push to the public backup repo.
EE-*/tests/test-final-*.pdf

# macOS, LaTeX build files, local build scratch.
.DS_Store
*.aux
*.log
*.out
*.toc
*.synctex.gz
.slides-build/
node_modules/
