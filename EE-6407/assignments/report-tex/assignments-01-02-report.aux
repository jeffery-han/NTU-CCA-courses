\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training samples projected onto the Fisher direction, with a histogram of $g(\mathbf  {x}) = \mathbf  {w}^T\mathbf  {x} + w_0$ per class (bin width $1\times 10^{-3}$) and the fitted 1-D Gaussians drawn over them. The heavy dashed line is the boundary $g = 0$, the thin dotted lines mark the projected class means shifted by the bias, $\tilde  {m}_1 + w_0$ and $\tilde  {m}_2 + w_0$, at $\pm 8.53\times 10^{-3}$, and the ticks below the axis are the 23 test samples.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:fisher}{{2}{8}{Training samples projected onto the Fisher direction, with a histogram of $g(\mathbf {x}) = \mathbf {w}^T\mathbf {x} + w_0$ per class (bin width $1\times 10^{-3}$) and the fitted 1-D Gaussians drawn over them. The heavy dashed line is the boundary $g = 0$, the thin dotted lines mark the projected class means shifted by the bias, $\tilde {m}_1 + w_0$ and $\tilde {m}_2 + w_0$, at $\pm 8.53\times 10^{-3}$, and the ticks below the axis are the 23 test samples}{figure.2}{}}
